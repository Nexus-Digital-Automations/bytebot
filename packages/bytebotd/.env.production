# Parlant Production Server Configuration
# Production-ready environment variables for real Parlant server integration
# This file configures connection to a production Parlant instance with enterprise-grade reliability

# ===== PRODUCTION PARLANT SERVER CONNECTION =====

# Enable Parlant integration for production (required: true)
PARLANT_ENABLED=true

# Production Parlant server URL (replace with actual production server)
# Common production endpoints:
# - Cloud: https://api.parlant.io
# - Self-hosted: https://parlant.yourcompany.com
# - Docker: http://parlant-server:8000
PARLANT_API_BASE_URL=https://api.parlant.io
PARLANT_SERVER_URL=https://api.parlant.io

# Production API authentication (required for production)
# This should be set via environment variables or secure secret management
# PARLANT_API_KEY=prod_key_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# WebSocket URL for real-time communication (derived from API URL by default)
PARLANT_WS_URL=wss://api.parlant.io/ws

# ===== PRODUCTION CONNECTION SETTINGS =====

# Connection timeout for production reliability (8 seconds)
PARLANT_API_TIMEOUT_MS=8000

# Validation timeout for enterprise performance (3 seconds)
PARLANT_VALIDATION_TIMEOUT_MS=3000

# Connection retry configuration for resilience
PARLANT_API_RETRIES=5
PARLANT_RETRY_DELAY_MS=1000
PARLANT_RETRY_BACKOFF_MULTIPLIER=2
PARLANT_MAX_RETRY_DELAY_MS=10000

# Circuit breaker configuration for production stability
PARLANT_CIRCUIT_BREAKER_ENABLED=true
PARLANT_CIRCUIT_BREAKER_FAILURE_THRESHOLD=10
PARLANT_CIRCUIT_BREAKER_TIMEOUT_MS=30000
PARLANT_CIRCUIT_BREAKER_RESET_TIMEOUT_MS=60000

# Connection pool configuration for high-throughput
PARLANT_CONNECTION_POOL_SIZE=10
PARLANT_CONNECTION_KEEP_ALIVE=true
PARLANT_CONNECTION_KEEP_ALIVE_TIMEOUT_MS=30000

# ===== PRODUCTION PERFORMANCE OPTIMIZATION =====

# High-performance caching for production workloads
PARLANT_CACHE_ENABLED=true
PARLANT_CACHE_SIZE=10000
PARLANT_CACHE_MAX_AGE_MS=300000
PARLANT_INTELLIGENT_CACHE_ENABLED=true

# Multi-level cache configuration
PARLANT_L1_ENABLED=true
PARLANT_L2_ENABLED=true
PARLANT_L3_ENABLED=true

# Redis cache for distributed environments (if available)
PARLANT_REDIS_ENABLED=false
# PARLANT_REDIS_HOST=redis.yourcompany.com
# PARLANT_REDIS_PORT=6379
# PARLANT_REDIS_PASSWORD=your_redis_password

# Performance monitoring for production
PARLANT_PERFORMANCE_MONITORING_ENABLED=true
PARLANT_PERFORMANCE_ALERTS_ENABLED=true
PARLANT_METRICS_INTERVAL_MS=30000

# Batch processing for efficiency
PARLANT_BATCHING_ENABLED=true
PARLANT_BATCH_SIZE=25
PARLANT_BATCH_TIMEOUT_MS=2000

# ===== PRODUCTION SECURITY CONFIGURATION =====

# Enhanced security for production environments
PARLANT_REQUIRE_HIGH_RISK_APPROVAL=true
PARLANT_ENABLE_THREAT_DETECTION=true
PARLANT_MAX_FAILED_VALIDATIONS=3
PARLANT_SUSPICIOUS_THRESHOLD=2

# Production authentication and authorization
PARLANT_ENABLE_RBAC=true
PARLANT_SESSION_TIMEOUT_MS=1800000
PARLANT_CONVERSATION_TIMEOUT_MS=3600000

# TLS/SSL configuration for secure communication
PARLANT_TLS_ENABLED=true
PARLANT_TLS_VERIFY_CERTIFICATES=true
PARLANT_TLS_MIN_VERSION=1.2

# Rate limiting for production API protection
PARLANT_RATE_LIMIT_ENABLED=true
PARLANT_RATE_LIMIT_REQUESTS_PER_MINUTE=1000
PARLANT_RATE_LIMIT_BURST_SIZE=50

# ===== PRODUCTION MONITORING AND LOGGING =====

# Production audit and compliance
PARLANT_AUDIT_ENABLED=true
PARLANT_ENTERPRISE_AUDIT_ENABLED=true
PARLANT_AUDIT_RETENTION_DAYS=365

# Logging configuration for production
PARLANT_LOG_LEVEL=info
PARLANT_ENABLE_AUDIT_LOGGING=true
PARLANT_ENABLE_PERFORMANCE_LOGGING=true
PARLANT_LOG_VALIDATION_DETAILS=false
PARLANT_LOG_CONVERSATION_CONTEXT=false

# Health monitoring for production reliability
PARLANT_ENABLE_HEALTH_CHECK=true
PARLANT_HEALTH_CHECK_INTERVAL_MS=15000
PARLANT_HEALTH_CHECK_TIMEOUT_MS=5000

# Metrics export for production monitoring
PARLANT_ENABLE_PROMETHEUS_METRICS=true
PARLANT_PROMETHEUS_PORT=9090
PARLANT_ENABLE_FAILURE_ALERTS=true
PARLANT_FAILURE_ALERT_THRESHOLD=0.05

# ===== PRODUCTION COMPLIANCE =====

# Regulatory compliance for production
PARLANT_ENABLE_GDPR_COMPLIANCE=true
PARLANT_ENABLE_SOX_COMPLIANCE=true
PARLANT_ENABLE_HIPAA_COMPLIANCE=false
PARLANT_ENABLE_ISO27001_COMPLIANCE=true

# Data classification and security
PARLANT_DATA_CLASSIFICATION=confidential
PARLANT_ENABLE_DATA_ANONYMIZATION=true
PARLANT_AUDIT_ENCRYPTION_ENABLED=true
PARLANT_AUDIT_DIGITAL_SIGNING_ENABLED=true

# ===== PRODUCTION FAILOVER AND DISASTER RECOVERY =====

# Failover configuration for high availability
PARLANT_RETRY_FAILOVER_ENABLED=true
PARLANT_FAILOVER_SERVERS=["https://api-backup.parlant.io", "https://api-dr.parlant.io"]

# Service discovery for dynamic environments
PARLANT_SERVICE_DISCOVERY_ENABLED=false
# PARLANT_SERVICE_DISCOVERY_URL=http://consul.yourcompany.com:8500

# Load balancing for production traffic
PARLANT_LOAD_BALANCING_ENABLED=true
PARLANT_LOAD_BALANCING_STRATEGY=round_robin

# ===== PRODUCTION CONCURRENCY SETTINGS =====

# High-concurrency configuration for production workloads
PARLANT_CONCURRENT_VALIDATIONS=20
PARLANT_CONCURRENT_CONNECTIONS=50
PARLANT_QUEUE_SIZE=1000

# Worker pool configuration
PARLANT_WORKER_POOL_SIZE=10
PARLANT_WORKER_TIMEOUT_MS=30000

# ===== PRODUCTION TESTING AND VALIDATION =====

# Connection validation settings
PARLANT_ENABLE_CONNECTION_VALIDATION=true
PARLANT_CONNECTION_VALIDATION_INTERVAL_MS=60000
PARLANT_CONNECTION_VALIDATION_TIMEOUT_MS=5000

# Service health validation
PARLANT_ENABLE_SERVICE_HEALTH_VALIDATION=true
PARLANT_SERVICE_HEALTH_CHECK_ENDPOINTS=["/health", "/ready", "/live"]

# API compatibility validation
PARLANT_ENABLE_API_VERSION_VALIDATION=true
PARLANT_REQUIRED_API_VERSION=2.0
PARLANT_COMPATIBLE_API_VERSIONS=["1.9", "2.0", "2.1"]

# ===== PRODUCTION OPTIMIZATIONS =====

# Cache warming for faster startup
PARLANT_CACHE_WARMING_ENABLED=true
PARLANT_CACHE_WARMING_CONCURRENCY=5

# Predictive caching for better performance
PARLANT_ENABLE_PREDICTIVE_CACHING=true
PARLANT_ML_CONFIDENCE_THRESHOLD=0.95

# Context learning for improved accuracy
PARLANT_ENABLE_CONTEXT_LEARNING=true
PARLANT_CONTEXT_LEARNING_RETENTION_DAYS=30

# ===== PRODUCTION DEPLOYMENT MODES =====

# Deployment environment identification
NODE_ENV=production
PARLANT_ENVIRONMENT=production
PARLANT_DEPLOYMENT_MODE=cluster

# Version and build information (set by CI/CD)
# PARLANT_BUILD_VERSION=1.0.0
# PARLANT_BUILD_COMMIT=abc123def456
# PARLANT_BUILD_DATE=2025-01-15T10:30:00Z

# ===== PRODUCTION NETWORK CONFIGURATION =====

# Network interface binding for production
PARLANT_BIND_ADDRESS=0.0.0.0
PARLANT_BIND_PORT=8080

# Proxy configuration for enterprise networks
# PARLANT_HTTP_PROXY=http://proxy.yourcompany.com:8080
# PARLANT_HTTPS_PROXY=https://proxy.yourcompany.com:8080
# PARLANT_NO_PROXY=localhost,127.0.0.1,.yourcompany.com

# DNS configuration for service resolution
PARLANT_DNS_TIMEOUT_MS=5000
PARLANT_DNS_RETRIES=3

# ===== PRODUCTION ALERTS AND NOTIFICATIONS =====

# External notification configuration
PARLANT_ENABLE_EXTERNAL_NOTIFICATIONS=true
# PARLANT_NOTIFICATION_ENDPOINT=https://monitoring.yourcompany.com/webhooks/parlant
# PARLANT_NOTIFICATION_API_KEY=notif_key_xxxxxxxxxxxxxxxx

# Alert channels configuration
PARLANT_ALERT_CHANNELS=["email", "slack", "pagerduty"]
# PARLANT_EMAIL_ALERTS_TO=devops@yourcompany.com
# PARLANT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
# PARLANT_PAGERDUTY_INTEGRATION_KEY=your_pagerduty_key

# ===== PRODUCTION SECURITY AUDIT =====

# Security scanning and validation
PARLANT_ENABLE_SECURITY_SCANNING=true
PARLANT_SECURITY_SCAN_INTERVAL_MS=300000

# Intrusion detection
PARLANT_ENABLE_INTRUSION_DETECTION=true
PARLANT_INTRUSION_DETECTION_SENSITIVITY=medium

# Access logging for security audit
PARLANT_ENABLE_ACCESS_LOGGING=true
PARLANT_ACCESS_LOG_FORMAT=combined
PARLANT_ACCESS_LOG_RETENTION_DAYS=90

# ===== PRODUCTION BACKUP AND RECOVERY =====

# Configuration backup
PARLANT_ENABLE_CONFIG_BACKUP=true
PARLANT_CONFIG_BACKUP_INTERVAL_MS=86400000

# Data backup configuration
PARLANT_ENABLE_DATA_BACKUP=true
PARLANT_DATA_BACKUP_SCHEDULE="0 2 * * *"
PARLANT_DATA_BACKUP_RETENTION_DAYS=90

# ===== PRODUCTION USAGE NOTES =====

# 1. Set PARLANT_API_KEY via secure environment variable injection
# 2. Configure Redis if running in distributed/clustered mode
# 3. Set up proper monitoring endpoints for health checks
# 4. Configure notification channels for production alerts
# 5. Ensure TLS certificates are properly configured
# 6. Review and adjust timeout values based on your network latency
# 7. Set up log aggregation and monitoring systems
# 8. Configure backup and disaster recovery procedures
# 9. Regularly review and update security configurations
# 10. Monitor performance metrics and adjust concurrency settings as needed