{
  "name": "@bytebot/performance-testing",
  "version": "1.0.0",
  "description": "Enterprise-grade performance testing framework with load simulation, benchmarking, and monitoring",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./load-testing": {
      "types": "./dist/load-testing/index.d.ts",
      "default": "./dist/load-testing/index.js"
    },
    "./benchmarking": {
      "types": "./dist/benchmarking/index.d.ts",
      "default": "./dist/benchmarking/index.js"
    },
    "./monitoring": {
      "types": "./dist/monitoring/index.d.ts",
      "default": "./dist/monitoring/index.js"
    },
    "./reporting": {
      "types": "./dist/reporting/index.d.ts",
      "default": "./dist/reporting/index.js"
    }
  },
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "jest --config jest.config.js",
    "test:unit": "jest --config jest.config.js --testPathPattern=unit",
    "test:integration": "jest --config jest.config.js --testPathPattern=integration",
    "test:performance": "jest --config jest.config.js --testPathPattern=performance",
    "test:coverage": "jest --config jest.config.js --coverage",
    "test:watch": "jest --config jest.config.js --watch",
    "test:ci": "jest --config jest.config.js --coverage --ci --watchAll=false",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "load-test": "ts-node src/cli/run-load-test.ts",
    "benchmark": "ts-node src/cli/run-benchmark.ts",
    "monitor": "ts-node src/cli/start-monitoring.ts",
    "analyze": "ts-node src/cli/analyze-results.ts",
    "report": "ts-node src/cli/generate-report.ts",
    "docs:generate": "typedoc src --out docs --excludePrivate"
  },
  "dependencies": {
    "@bytebot/shared": "workspace:*",
    "@bytebot/integration-testing": "workspace:*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "axios": "^1.7.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^12.0.0",
    "autocannon": "^7.15.0",
    "clinic": "^13.0.0",
    "0x": "^5.7.0",
    "artillery": "^2.0.20",
    "k6": "^0.52.0",
    "loadtest": "^8.0.9",
    "systeminformation": "^5.23.5",
    "pidusage": "^3.0.2",
    "prom-client": "^15.1.3",
    "chart.js": "^4.4.6",
    "d3": "^7.9.0",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "winston": "^3.14.2",
    "pino": "^9.4.0",
    "express": "^4.21.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.1",
    "@types/uuid": "^10.0.0",
    "@types/lodash": "^4.17.7",
    "@types/express": "^5.0.3",
    "@types/ws": "^8.5.12",
    "@types/d3": "^7.4.3",
    "typescript": "^5.9.2",
    "eslint": "^9.35.0",
    "prettier": "^3.6.2",
    "jest": "^30.1.3",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript-eslint": "^8.20.0",
    "jest-environment-node": "^30.1.2",
    "typedoc": "^0.26.11"
  },
  "keywords": [
    "performance-testing",
    "load-testing",
    "stress-testing",
    "benchmarking",
    "monitoring",
    "metrics",
    "scalability",
    "throughput",
    "latency",
    "bytebot",
    "enterprise"
  ],
  "author": "Bytebot Engineering Team",
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/src"],
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/tests/**/*.test.ts",
      "**/*.spec.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts",
      "!src/**/__tests__/**",
      "!src/**/tests/**",
      "!src/cli/**"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": ["text", "lcov", "html", "json"],
    "setupFilesAfterEnv": ["<rootDir>/src/test-setup.ts"],
    "testTimeout": 60000,
    "maxConcurrency": 3
  }
}