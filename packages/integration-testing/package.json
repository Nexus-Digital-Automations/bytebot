{
  "name": "@bytebot/integration-testing",
  "version": "1.0.0",
  "description": "Enterprise-grade integration testing framework with automated test generation, cross-service validation, and continuous testing",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./generators": {
      "types": "./dist/generators/index.d.ts",
      "default": "./dist/generators/index.js"
    },
    "./runners": {
      "types": "./dist/runners/index.d.ts",
      "default": "./dist/runners/index.js"
    },
    "./validators": {
      "types": "./dist/validators/index.d.ts",
      "default": "./dist/validators/index.js"
    }
  },
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "jest --config jest.config.js",
    "test:unit": "jest --config jest.config.js --testPathPattern=unit",
    "test:integration": "jest --config jest.config.js --testPathPattern=integration",
    "test:e2e": "jest --config jest.config.js --testPathPattern=e2e",
    "test:performance": "jest --config jest.config.js --testPathPattern=performance",
    "test:security": "jest --config jest.config.js --testPathPattern=security",
    "test:coverage": "jest --config jest.config.js --coverage",
    "test:watch": "jest --config jest.config.js --watch",
    "test:ci": "jest --config jest.config.js --coverage --ci --watchAll=false",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "test:generate": "ts-node src/cli/generate-tests.ts",
    "test:run-suite": "ts-node src/cli/run-test-suite.ts",
    "test:validate-contracts": "ts-node src/cli/validate-contracts.ts",
    "test:benchmark": "ts-node src/cli/benchmark.ts",
    "test:data-setup": "ts-node src/cli/setup-test-data.ts",
    "docs:generate": "typedoc src --out docs --excludePrivate"
  },
  "dependencies": {
    "@bytebot/shared": "workspace:*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/testing": "^11.1.6",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "axios": "^1.7.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^12.0.0",
    "ws": "^8.18.3",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^3.0.2",
    "helmet": "^8.1.0",
    "joi": "^17.13.3",
    "zod": "^3.23.8",
    "nock": "^13.5.4",
    "sqlite3": "^5.1.7",
    "pg": "^8.12.0",
    "lodash": "^4.17.21",
    "yaml": "^2.5.1",
    "winston": "^3.14.2",
    "pino": "^9.4.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.1",
    "@types/uuid": "^10.0.0",
    "@types/lodash": "^4.17.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ws": "^8.5.12",
    "@types/pg": "^8.11.10",
    "typescript": "^5.9.2",
    "eslint": "^9.35.0",
    "prettier": "^3.6.2",
    "jest": "^30.1.3",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript-eslint": "^8.20.0",
    "jest-environment-node": "^30.1.2",
    "supertest": "^7.1.4",
    "puppeteer": "^23.8.0",
    "typedoc": "^0.26.11"
  },
  "keywords": [
    "integration-testing",
    "test-automation",
    "api-testing",
    "contract-testing",
    "performance-testing",
    "security-testing",
    "database-testing",
    "cross-service-testing",
    "test-generation",
    "bytebot",
    "nestjs",
    "enterprise"
  ],
  "author": "Bytebot Engineering Team",
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/src"],
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/tests/**/*.test.ts",
      "**/*.spec.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts",
      "!src/**/__tests__/**",
      "!src/**/tests/**",
      "!src/cli/**"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": ["text", "lcov", "html", "json"],
    "setupFilesAfterEnv": ["<rootDir>/src/test-setup.ts"],
    "testTimeout": 30000,
    "maxConcurrency": 5
  }
}