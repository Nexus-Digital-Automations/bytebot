{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Shared Package Test Configuration",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node", "@jest/globals", "jest"],
    "noImplicitAny": false,
    "strictNullChecks": false,
    "strict": false,
    "skipLibCheck": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "__tests__/**/*",
    "src/**/__tests__/**/*", 
    "src/**/test-utils/**/*",
    "test-*",
    "**/test-*",
    "src/test-utils/**/*",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "coverage"
  ]
}