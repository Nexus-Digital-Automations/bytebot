{
  "name": "@bytebot/shared",
  "version": "0.0.1",
  "description": "Shared utilities and types for Bytebot packages",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "npx tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "npx eslint src/types src/config src/pipes src/validation src/dto src/guards src/decorators --ext .ts --fix && echo 'Core directories linted successfully. Large security/utils files excluded to prevent timeout.'",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --config jest.config.js --watch",
    "test:coverage": "jest --config jest.config.js --coverage",
    "test:ci": "jest --config jest.config.js --coverage --ci --watchAll=false",
    "prepublishOnly": "npm run build",
    "security:test": "ts-node src/test-utils/run-security-tests.ts",
    "security:pentest": "ts-node src/test-utils/run-security-tests.ts pentest",
    "security:network": "ts-node src/test-utils/run-security-tests.ts network",
    "security:validate": "ts-node src/test-utils/run-security-tests.ts validate",
    "security:config": "ts-node src/test-utils/run-security-tests.ts config"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/index-client.d.ts",
      "import": "./dist/index-client.js",
      "require": "./dist/index-client.js"
    },
    "./server": {
      "types": "./dist/index-server.d.ts",
      "import": "./dist/index-server.js",
      "require": "./dist/index-server.js"
    },
    "./minimal": {
      "types": "./dist/index-minimal.d.ts",
      "import": "./dist/index-minimal.js",
      "require": "./dist/index-minimal.js"
    },
    "./middleware/security-middleware.standardized": {
      "types": "./dist/middleware/security-middleware.standardized.d.ts",
      "import": "./dist/middleware/security-middleware.standardized.js",
      "require": "./dist/middleware/security-middleware.standardized.js"
    }
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@jest/globals": "^30.1.2",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/cors": "^2.8.19",
    "@types/jest": "^30.0.0",
    "@types/sanitize-html": "2.16.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^15.14.0",
    "jest": "^30.1.3",
    "jest-html-reporters": "^3.1.7",
    "jest-junit": "^16.0.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.4.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.20.0"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/microservices": "^11.1.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^5.0.3",
    "@types/js-yaml": "^4.0.5",
    "@types/jsdom": "^21.1.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "axios": "^1.7.7",
    "bcryptjs": "^3.0.2",
    "cache-manager": "^7.2.0",
    "cache-manager-redis-store": "^3.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "commander": "^12.1.0",
    "dompurify": "^3.2.6",
    "helmet": "^8.1.0",
    "js-yaml": "^4.1.0",
    "jsdom": "^26.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.17.0",
    "ts-node": "^10.9.2"
  }
}
