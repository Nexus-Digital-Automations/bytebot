{
  "name": "@parlant/testing-framework",
  "version": "1.0.0",
  "description": "PARLANT Bytebot Middleware Testing Framework - Enterprise-Grade Testing Infrastructure",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "private": true,
  "license": "UNLICENSED",
  "keywords": [
    "parlant",
    "bytebot",
    "testing",
    "middleware",
    "quality-assurance",
    "enterprise",
    "ci-cd",
    "automation"
  ],
  "author": "Claude Code (Testing Framework Architect)",
  "scripts": {
    "// === FRAMEWORK MANAGEMENT ===": "",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist coverage node_modules/.cache",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "lint": "eslint \"**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",

    "// === COMPREHENSIVE TESTING ===": "",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --config jest.config.js --watch",
    "test:coverage": "jest --config jest.config.js --coverage",
    "test:ci": "jest --config jest.config.js --coverage --ci --watchAll=false --passWithNoTests",
    "test:debug": "jest --config jest.config.js --runInBand --verbose",

    "// === FRAMEWORK-SPECIFIC TESTING ===": "",
    "test:unit": "jest --config jest.config.js --selectProjects \"Unit Tests\"",
    "test:integration": "jest --config jest.config.js --selectProjects \"Integration Tests\"",
    "test:e2e": "jest --config jest.config.js --selectProjects \"E2E Tests\"",
    "test:performance": "jest --config jest.config.js --selectProjects \"Performance Tests\"",
    "test:security": "jest --config jest.config.js --selectProjects \"Security Tests\"",
    "test:compatibility": "jest --config jest.config.js --selectProjects \"Compatibility Tests\"",
    "test:quality-gates": "jest --config jest.config.js --selectProjects \"Quality Gates\"",

    "// === PARALLEL TESTING ===": "",
    "test:parallel": "concurrently \"npm run test:unit\" \"npm run test:integration\" \"npm run test:security\"",
    "test:parallel:all": "concurrently \"npm run test:unit\" \"npm run test:integration\" \"npm run test:security\" \"npm run test:compatibility\"",

    "// === PERFORMANCE TESTING ===": "",
    "test:performance:load": "jest --config jest.config.js --testNamePattern=\"load test\"",
    "test:performance:stress": "jest --config jest.config.js --testNamePattern=\"stress test\"",
    "test:performance:endurance": "jest --config jest.config.js --testNamePattern=\"endurance test\"",
    "test:performance:benchmark": "jest --config jest.config.js --testNamePattern=\"benchmark\"",

    "// === SECURITY TESTING ===": "",
    "test:security:vulnerability": "jest --config jest.config.js --testNamePattern=\"vulnerability\"",
    "test:security:penetration": "jest --config jest.config.js --testNamePattern=\"penetration\"",
    "test:security:authentication": "jest --config jest.config.js --testNamePattern=\"authentication\"",
    "test:security:authorization": "jest --config jest.config.js --testNamePattern=\"authorization\"",
    "test:security:compliance": "jest --config jest.config.js --testNamePattern=\"compliance\"",

    "// === COMPATIBILITY TESTING ===": "",
    "test:compatibility:backward": "jest --config jest.config.js --testNamePattern=\"backward compatibility\"",
    "test:compatibility:api": "jest --config jest.config.js --testNamePattern=\"api compatibility\"",
    "test:compatibility:migration": "jest --config jest.config.js --testNamePattern=\"migration\"",
    "test:compatibility:cross-platform": "jest --config jest.config.js --testNamePattern=\"cross-platform\"",

    "// === QUALITY GATES ===": "",
    "test:quality-gates:validate": "jest --config jest.config.js --testNamePattern=\"quality gates\"",
    "test:quality-gates:ci": "npm run test:quality-gates:validate -- --ci",
    "test:quality-gates:report": "npm run test:quality-gates:validate -- --coverage",

    "// === COVERAGE ANALYSIS ===": "",
    "coverage": "jest --config jest.config.js --coverage --passWithNoTests",
    "coverage:unit": "jest --config jest.config.js --coverage --selectProjects \"Unit Tests\"",
    "coverage:integration": "jest --config jest.config.js --coverage --selectProjects \"Integration Tests\"",
    "coverage:e2e": "jest --config jest.config.js --coverage --selectProjects \"E2E Tests\"",
    "coverage:open": "open coverage/lcov-report/index.html",
    "coverage:summary": "jest --config jest.config.js --coverage --coverageReporters=text-summary",

    "// === REPORTING ===": "",
    "report": "npm run coverage && npm run report:html && npm run report:junit",
    "report:html": "jest --config jest.config.js --coverage --coverageReporters=html",
    "report:junit": "jest --config jest.config.js --coverage --coverageReporters=cobertura",
    "report:json": "jest --config jest.config.js --coverage --coverageReporters=json",
    "report:lcov": "jest --config jest.config.js --coverage --coverageReporters=lcov",

    "// === FRAMEWORK VALIDATION ===": "",
    "validate": "npm run lint && npm run typecheck && npm run test:ci",
    "validate:framework": "npm run test:unit && npm run test:integration && npm run test:security",
    "validate:full": "npm run validate && npm run test:performance && npm run test:e2e && npm run test:compatibility",

    "// === DEVELOPMENT UTILITIES ===": "",
    "dev": "jest --config jest.config.js --watch --verbose",
    "dev:unit": "jest --config jest.config.js --watch --selectProjects \"Unit Tests\"",
    "dev:integration": "jest --config jest.config.js --watch --selectProjects \"Integration Tests\"",
    "debug": "node --inspect-brk node_modules/.bin/jest --config jest.config.js --runInBand",

    "// === BENCHMARK AND PROFILING ===": "",
    "benchmark": "npm run test:performance:benchmark",
    "profile": "jest --config jest.config.js --logHeapUsage --detectOpenHandles",
    "profile:memory": "node --max-old-space-size=4096 node_modules/.bin/jest --config jest.config.js --logHeapUsage",

    "// === CI/CD INTEGRATION ===": "",
    "ci:install": "npm ci",
    "ci:test": "npm run test:ci",
    "ci:validate": "npm run validate",
    "ci:quality-gates": "npm run test:quality-gates:ci",
    "ci:full": "npm run ci:validate && npm run ci:quality-gates",

    "// === MAINTENANCE ===": "",
    "update:snapshots": "jest --config jest.config.js --updateSnapshot",
    "clear:cache": "jest --config jest.config.js --clearCache",
    "doctor": "jest --config jest.config.js --showConfig"
  },
  "dependencies": {
    "@jest/globals": "^30.1.2",
    "jest": "^30.1.3",
    "ts-jest": "^29.4.1",
    "playwright": "^1.40.1",
    "puppeteer": "^21.6.1",
    "axios": "^1.7.7",
    "ws": "^8.18.3",
    "owasp-zap-api": "^1.0.0",
    "performance-now": "^2.1.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-jest": "^28.9.0",
    "eslint-plugin-prettier": "^5.2.2",
    "jest-environment-jsdom": "^30.1.2",
    "jest-environment-node": "^30.1.2",
    "jest-html-reporters": "^3.1.7",
    "jest-junit": "^16.0.0",
    "prettier": "^3.4.2",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bytebot-ai/parlant-testing-framework.git"
  },
  "bugs": {
    "url": "https://github.com/bytebot-ai/parlant-testing-framework/issues"
  },
  "homepage": "https://github.com/bytebot-ai/parlant-testing-framework#readme",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "registry": "https://npm.bytebot.ai"
  }
}