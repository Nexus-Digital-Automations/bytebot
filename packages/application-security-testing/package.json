{
  "name": "@bytebot/application-security-testing",
  "version": "1.0.0",
  "description": "Comprehensive application security testing framework with SAST, DAST, IAST, and OWASP Top 10 validation",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ast-scan": "dist/cli.js",
    "security-test": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --config=jest.integration.config.js",
    "test:e2e": "jest --config=jest.e2e.config.js",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "start": "node dist/cli.js",
    "scan:sast": "node dist/cli.js sast",
    "scan:dast": "node dist/cli.js dast",
    "scan:iast": "node dist/cli.js iast",
    "scan:owasp": "node dist/cli.js owasp",
    "scan:all": "node dist/cli.js scan --all",
    "security:audit": "npm audit && node dist/cli.js audit",
    "security:report": "node dist/cli.js report",
    "security:dashboard": "node dist/dashboard.js",
    "ci:security": "node dist/ci-integration.js"
  },
  "keywords": [
    "application-security",
    "sast",
    "dast",
    "iast",
    "owasp-top-10",
    "vulnerability-scanning",
    "security-testing",
    "static-analysis",
    "dynamic-analysis",
    "interactive-testing",
    "security-automation",
    "penetration-testing",
    "code-security",
    "web-security",
    "api-security"
  ],
  "author": "ByteBot Security Team",
  "license": "MIT",
  "dependencies": {
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.0",
    "eslint-plugin-security": "^1.7.1",
    "semgrep": "^1.45.0",
    "sonarjs": "^1.13.0",
    "bandit": "^3.0.0",
    "retired": "^4.0.0",
    "snyk": "^1.1291.0",
    "owasp-zap": "^0.2.3",
    "puppeteer": "^21.11.0",
    "playwright": "^1.40.1",
    "selenium-webdriver": "^4.15.0",
    "express": "^4.18.2",
    "axios": "^1.6.2",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "winston": "^3.11.0",
    "moment": "^2.29.4",
    "lodash": "^4.17.21",
    "uuid": "^9.0.1",
    "joi": "^17.11.0",
    "yaml": "^2.3.4",
    "xml2js": "^0.6.2",
    "csv-parser": "^3.0.0",
    "fast-csv": "^4.3.6",
    "ws": "^8.14.2",
    "socket.io": "^4.7.4",
    "node-cron": "^3.0.3",
    "dotenv": "^16.3.1",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "rate-limiter-flexible": "^3.0.8",
    "jsonwebtoken": "^9.0.2",
    "bcrypt": "^5.1.1",
    "crypto-js": "^4.2.0",
    "node-fetch": "^3.3.2",
    "cheerio": "^1.0.0-rc.12",
    "jsdom": "^23.0.1",
    "pdf-parse": "^1.1.1",
    "xlsx": "^0.18.5",
    "zxcvbn": "^4.4.2",
    "validator": "^13.11.0",
    "dompurify": "^3.0.6",
    "sql-injection-scanner": "^1.0.0",
    "xss-filters": "^1.2.7",
    "node-forge": "^1.3.1",
    "tls-fingerprint": "^1.1.0",
    "http-security-headers": "^1.0.0",
    "csp-evaluator": "^1.1.1",
    "sharp": "^0.32.6",
    "jimp": "^0.22.10"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@types/express": "^4.17.21",
    "@types/lodash": "^4.14.202",
    "@types/uuid": "^9.0.7",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/cors": "^2.8.17",
    "@types/ws": "^8.5.10",
    "@types/xml2js": "^0.4.14",
    "@types/validator": "^13.11.7",
    "@types/crypto-js": "^4.2.1",
    "@types/dompurify": "^3.0.5",
    "@types/jest": "^29.5.11",
    "@types/supertest": "^2.0.16",
    "typescript": "^5.3.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "supertest": "^6.3.3",
    "prettier": "^3.1.1",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "nodemon": "^3.0.2",
    "concurrently": "^8.2.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/src", "<rootDir>/tests"],
    "testMatch": ["**/__tests__/**/*.ts", "**/?(*.)+(spec|test).ts"],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts",
      "!src/cli.ts",
      "!src/dashboard.ts"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": ["text", "lcov", "html", "json"],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "setupFilesAfterEnv": ["<rootDir>/tests/setup.ts"]
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "files": [
    "dist/**/*",
    "configs/**/*",
    "docs/**/*",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bytebot-ai/application-security-testing.git"
  },
  "bugs": {
    "url": "https://github.com/bytebot-ai/application-security-testing/issues"
  },
  "homepage": "https://github.com/bytebot-ai/application-security-testing#readme"
}