{
  "name": "@bytebot/document-automation",
  "version": "0.0.1",
  "description": "Enterprise document automation system with template management, dynamic generation, and workflow integration",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index-server.d.ts",
      "default": "./dist/index-server.js"
    }
  },
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "npx tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "npx eslint \"src/**/*.ts\" --fix",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --config jest.config.js --watch",
    "test:coverage": "jest --config jest.config.js --coverage",
    "test:ci": "jest --config jest.config.js --coverage --ci --watchAll=false",
    "test:integration": "jest --config jest.config.js --testPathPattern=integration.spec.ts$",
    "test:unit": "jest --config jest.config.js --testPathPattern=spec.ts$",
    "start": "npx @nestjs/cli start",
    "start:dev": "npx @nestjs/cli start --watch",
    "start:debug": "npx @nestjs/cli start --debug --watch",
    "start:prod": "node dist/src/main",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@bytebot/shared": "workspace:*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.3",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/cache-manager": "^3.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/uuid": "^10.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^12.0.0",
    "rxjs": "^7.8.2",
    "reflect-metadata": "^0.2.2",
    "cache-manager": "^7.2.0",
    "multer": "^2.0.2",
    "puppeteer": "^23.10.4",
    "pdf-lib": "^1.17.1",
    "docx": "^8.5.0",
    "xlsx": "^0.18.5",
    "handlebars": "^4.7.8",
    "jsdom": "^26.1.0",
    "sharp": "0.34.3",
    "sqlite3": "^5.1.7",
    "typeorm": "^0.3.20",
    "helmet": "^8.1.0",
    "express-rate-limit": "^8.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.13.14",
    "@types/supertest": "^6.0.2",
    "@types/handlebars": "^4.1.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "jest": "^30.1.3",
    "jest-html-reporters": "^3.1.7",
    "jest-junit": "^16.0.0",
    "prettier": "^3.4.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.20.0"
  },
  "files": [
    "dist"
  ]
}