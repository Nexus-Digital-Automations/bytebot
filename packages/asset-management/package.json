{
  "name": "@bytebot/asset-management",
  "version": "0.0.1",
  "description": "Enterprise Digital Asset Management System - Core Service",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "npx tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "npx eslint \"src/**/*.ts\" --fix",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --config jest.config.js --watch",
    "test:coverage": "jest --config jest.config.js --coverage",
    "test:e2e": "jest --config jest.config.e2e.js",
    "start": "node dist/main.js",
    "start:dev": "npx ts-node -r tsconfig-paths/register src/main.ts",
    "start:debug": "npx ts-node --inspect-brk -r tsconfig-paths/register src/main.ts",
    "start:prod": "node dist/main.js"
  },
  "dependencies": {
    "@bytebot/shared": "file:../shared",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/typeorm": "^10.0.5",
    "@nestjs/config": "^4.0.2",
    "@nestjs/jwt": "^10.3.1",
    "@nestjs/passport": "^10.1.0",
    "@nestjs/swagger": "^8.0.8",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/websockets": "^11.1.6",
    "@nestjs/platform-socket.io": "^11.1.6",
    "typeorm": "^0.3.21",
    "sqlite3": "^5.1.7",
    "pg": "^8.13.1",
    "multer": "^2.0.2",
    "sharp": "^0.33.5",
    "ffmpeg-static": "^5.2.0",
    "class-validator": "^0.14.2",
    "class-transformer": "^0.5.1",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "bcryptjs": "^3.0.2",
    "rxjs": "^7.8.2",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.3",
    "jsonwebtoken": "^9.0.2",
    "mime-types": "^2.1.35",
    "file-type": "^19.8.1",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.3",
    "@types/passport-local": "^1.0.40",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@types/mime-types": "^2.1.4",
    "jest": "^30.1.3",
    "ts-jest": "^29.4.1",
    "typescript": "^5.9.2",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}