generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Task {
  id           String       @id @default(uuid())
  description  String
  status       TaskStatus   @default(PENDING)
  priority     TaskPriority @default(MEDIUM)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  completedAt  DateTime?
  error        String?
  executedAt   DateTime?
  result       Json?
  type         TaskType     @default(IMMEDIATE)
  queuedAt     DateTime?
  scheduledFor DateTime?
  model        Json
  userId       String?
  createdBy    MessageRole  @default(USER)
  control      MessageRole  @default(ASSISTANT)
  files        File[]
  messages     Message[]
  summaries    Summary[]
  user         User?        @relation(fields: [userId], references: [id])
}

model Summary {
  id             String    @id @default(uuid())
  content        String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  taskId         String
  parentId       String?
  messages       Message[]
  parentSummary  Summary?  @relation("SummaryHierarchy", fields: [parentId], references: [id])
  childSummaries Summary[] @relation("SummaryHierarchy")
  task           Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Message {
  id        String      @id @default(uuid())
  content   Json
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  taskId    String
  summaryId String?
  role      MessageRole @default(ASSISTANT)
  summary   Summary?    @relation(fields: [summaryId], references: [id])
  task      Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model File {
  id        String   @id @default(uuid())
  name      String
  type      String
  size      Int
  data      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model User {
  id            String           @id @default(uuid())
  email         String           @unique
  username      String           @unique
  firstName     String?
  lastName      String?
  passwordHash  String
  role          UserRole         @default(VIEWER)
  isActive      Boolean          @default(true)
  emailVerified Boolean          @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  tasks         Task[]
  browserTasks  BrowserTask[]
  permissions   RolePermission[]
  sessions      UserSession[]

  @@map("users")
}

model UserSession {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  isRevoked    Boolean  @default(false)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  ipAddress    String?
  userAgent    String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model RolePermission {
  id         String     @id @default(uuid())
  userId     String
  role       UserRole
  permission Permission
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role, permission])
  @@map("role_permissions")
}

model BrowserSession {
  id                 String               @id @default(uuid())
  processId          String?
  status             BrowserSessionStatus @default(ACTIVE)
  headless           Boolean              @default(true)
  viewportWidth      Int                  @default(1280)
  viewportHeight     Int                  @default(720)
  userAgent          String?
  workingDirectory   String?
  screenshotsEnabled Boolean              @default(true)
  videoRecording     Boolean              @default(false)
  timeoutMs          Int                  @default(300000)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  terminatedAt       DateTime?
  lastActivity       DateTime             @default(now())
  error              String?
  metadata           Json?
  domSnapshots       BrowserDomSnapshot[]
  screenshots        BrowserScreenshot[]
  tasks              BrowserTask[]

  @@map("browser_sessions")
}

model BrowserTask {
  id                   String                  @id @default(uuid())
  externalTaskId       String?
  sessionId            String
  type                 String
  status               BrowserTaskStatus       @default(PENDING)
  priority             BrowserTaskPriority     @default(NORMAL)
  startUrl             String?
  actions              Json
  configuration        Json
  constraints          Json?
  validation           Json?
  options              Json?
  retryOptions         Json?
  timeoutSeconds       Int?                    @default(300)
  tags                 String[]                @default([])
  customData           Json?
  currentStep          Int                     @default(0)
  totalSteps           Int                     @default(1)
  startedAt            DateTime?
  completedAt          DateTime?
  lastActivity         DateTime                @default(now())
  estimatedRemainingMs Int?
  result               Json?
  error                Json?
  userId               String?
  agentId              String?
  retryCount           Int                     @default(0)
  maxRetries           Int                     @default(3)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  dataExtractions      BrowserDataExtraction[]
  domSnapshots         BrowserDomSnapshot[]
  formData             BrowserFormData[]
  screenshots          BrowserScreenshot[]
  executionSteps       BrowserTaskStep[]
  session              BrowserSession          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user                 User?                   @relation(fields: [userId], references: [id])

  @@map("browser_tasks")
}

model BrowserTaskStep {
  id          String            @id @default(uuid())
  taskId      String
  stepNumber  Int
  action      String
  status      BrowserTaskStatus @default(PENDING)
  startedAt   DateTime?
  completedAt DateTime?
  durationMs  Int?
  result      String?
  error       String?
  metadata    Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  task        BrowserTask       @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, stepNumber])
  @@map("browser_task_steps")
}

model BrowserScreenshot {
  id              String          @id @default(uuid())
  sessionId       String
  taskId          String?
  filename        String
  filePath        String
  url             String?
  viewport        Json
  timestamp       DateTime        @default(now())
  fileSize        Int
  mimeType        String          @default("image/png")
  metadata        Json?
  accessCount     Int             @default(0)
  archivedAt      DateTime?
  checksum        String?
  compressedSize  Int?
  compressionType CompressionType @default(NONE)
  lastAccessed    DateTime        @default(now())
  storageTier     StorageTier     @default(HOT)
  session         BrowserSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  task            BrowserTask?    @relation(fields: [taskId], references: [id])

  @@map("browser_screenshots")
}

model BrowserDomSnapshot {
  id                  String          @id @default(uuid())
  sessionId           String
  taskId              String?
  url                 String
  title               String?
  htmlContent         String?
  accessibilityTree   Json?
  interactiveElements Json?
  extractedText       String?
  metadata            Json?
  timestamp           DateTime        @default(now())
  fileSize            Int?
  accessCount         Int             @default(0)
  archivedAt          DateTime?
  compressedSize      Int?
  compressionType     CompressionType @default(NONE)
  elementCount        Int?
  formCount           Int?
  htmlCompressed      Bytes?
  imageCount          Int?
  lastAccessed        DateTime        @default(now())
  linkCount           Int?
  originalSize        Int?
  pageLoadTimeMs      Int?
  renderTimeMs        Int?
  scriptCount         Int?
  storageTier         StorageTier     @default(HOT)
  textContentHash     String?
  session             BrowserSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  task                BrowserTask?    @relation(fields: [taskId], references: [id])

  @@map("browser_dom_snapshots")
}

model BrowserFormData {
  id               String      @id @default(uuid())
  taskId           String
  formSelector     String
  fieldName        String
  fieldType        String
  fieldValue       String?
  isSubmitted      Boolean     @default(false)
  submittedAt      DateTime?
  validationResult Json?
  metadata         Json?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  task             BrowserTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("browser_form_data")
}

model BrowserDataExtraction {
  id               String      @id @default(uuid())
  taskId           String
  extractionType   String
  selector         String?
  extractedData    Json
  rawContent       String?
  processedContent Json?
  confidence       Float?      @default(1.0)
  metadata         Json?
  extractedAt      DateTime    @default(now())
  task             BrowserTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("browser_data_extractions")
}

enum TaskStatus {
  PENDING
  RUNNING
  NEEDS_HELP
  NEEDS_REVIEW
  COMPLETED
  CANCELLED
  FAILED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MessageRole {
  USER
  ASSISTANT
}

enum UserRole {
  ADMIN
  OPERATOR
  VIEWER
}

enum Permission {
  TASK_READ
  TASK_WRITE
  TASK_DELETE
  COMPUTER_CONTROL
  SYSTEM_ADMIN
  USER_MANAGEMENT
}

enum TaskType {
  IMMEDIATE
  SCHEDULED
}

enum BrowserTaskStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum BrowserTaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum BrowserSessionStatus {
  ACTIVE
  IDLE
  TERMINATED
  ERROR
}

enum StorageTier {
  HOT
  WARM
  COLD
  ARCHIVED
}

enum CompressionType {
  NONE
  GZIP
  BROTLI
  ZSTD
}
