{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Bytebot Agent Package",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "Node16", 
    "moduleResolution": "node16",
    "declaration": true,
    "declarationMap": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "rootDir": "./src",
    "incremental": false,
    "composite": true,
    "skipLibCheck": true,
    "noImplicitOverride": false,
    "strict": false,
    "noEmitOnError": false,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "strictFunctionTypes": true,
    "strictPropertyInitialization": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "types": ["node", "jest"]
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "**/*.js",
    "**/*.spec.ts",
    "src/auth/controllers/parlant-validated-auth.controller.ts",
    "src/auth/services/parlant-validated-*.ts",
    "src/database/services/parlant-validated-*.ts",
    "src/database/security/parlant-validated-*.ts",
    "src/prisma/parlant-validated-*.ts",
    "src/config/parlant-*.ts"
  ],
  "references": [
    {
      "path": "../shared"
    }
  ]
}
