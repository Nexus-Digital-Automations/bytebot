# Bytebot Agent - Local-Only Configuration Example
# Copy this file to .env.local and fill in your actual values
# This file demonstrates 100% local deployment configuration

#=============================================================================
# CORE LOCAL DEPLOYMENT CONFIGURATION
#=============================================================================

# Node Environment
NODE_ENV=production

# Local Deployment Type (docker-compose or standalone)
LOCAL_DEPLOYMENT_TYPE=docker-compose

# Local Data Directory (for file storage)
LOCAL_DATA_DIRECTORY=./data

# Port Configuration
PORT=9991

#=============================================================================
# LOCAL DATABASE CONFIGURATION (No Cloud Dependencies)
#=============================================================================

# Local PostgreSQL Database (Docker Compose)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bytebotdb

# For SQLite (single-user deployment alternative)
# DATABASE_URL=sqlite:./data/bytebot.db

# Database Connection Pool
DATABASE_MAX_CONNECTIONS=20
DATABASE_CONNECTION_TIMEOUT=30000

#=============================================================================
# LOCAL SECRETS MANAGEMENT (Encrypted File-Based)
#=============================================================================

# Local secrets directory path
LOCAL_SECRETS_DIR=./.env/secrets

# Encryption key for local secrets (CHANGE THIS IN PRODUCTION!)
LOCAL_SECRETS_ENCRYPTION_KEY=your-256-bit-encryption-key-change-this-in-production

# JWT Configuration (stored in local encrypted files)
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Encryption key for data protection
ENCRYPTION_KEY=your-encryption-key-for-data-protection-32-chars-minimum

#=============================================================================
# AI SERVICE API KEYS (Only External Dependencies)
#=============================================================================

# These will be stored in encrypted local file storage automatically
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
OPENAI_API_KEY=sk-your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

#=============================================================================
# LOCAL SERVICE URLS (Docker Compose Internal Networking)
#=============================================================================

# Bytebot Desktop Service (local container networking)
BYTEBOT_DESKTOP_BASE_URL=http://bytebot-desktop:9990

# Optional: LLM Proxy URL (if using local proxy)
# BYTEBOT_LLM_PROXY_URL=http://localhost:8080

# Optional: Analytics endpoint (local only)
# BYTEBOT_ANALYTICS_ENDPOINT=http://localhost:9093

#=============================================================================
# API CONFIGURATION (Local Deployment)
#=============================================================================

# Rate Limiting (per 15 minutes)
API_RATE_LIMIT_WINDOW=900000
API_RATE_LIMIT_MAX_REQUESTS=100

# CORS Origins (localhost for development)
API_CORS_ORIGINS=http://localhost:3000,http://localhost:9992

# Request Configuration
BODY_PARSER_LIMIT=50mb
REQUEST_TIMEOUT=30000

#=============================================================================
# FEATURE FLAGS (Local Deployment Optimized)
#=============================================================================

# Authentication (enable for production)
ENABLE_AUTHENTICATION=true

# Rate limiting (recommended for local production)
ENABLE_RATE_LIMITING=true

# Metrics collection (local monitoring)
ENABLE_METRICS_COLLECTION=true

# Health checks (always recommended)
ENABLE_HEALTH_CHECKS=true

# Circuit breaker (for local resilience)
ENABLE_CIRCUIT_BREAKER=true

#=============================================================================
# LOCAL MONITORING CONFIGURATION (No Cloud Services)
#=============================================================================

# Prometheus metrics port (local monitoring)
PROMETHEUS_METRICS_PORT=9464

# Logging configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Distributed tracing (set to false for local-only)
ENABLE_DISTRIBUTED_TRACING=false

# Jaeger endpoint (only if using local Jaeger)
# JAEGER_ENDPOINT=http://localhost:14268/api/traces

#=============================================================================
# PERFORMANCE CONFIGURATION
#=============================================================================

# Graceful shutdown timeout
GRACEFUL_SHUTDOWN_TIMEOUT=10000

# Circuit breaker settings
CIRCUIT_BREAKER_FAILURE_THRESHOLD=50
CIRCUIT_BREAKER_TIMEOUT=60000
CIRCUIT_BREAKER_RESET_TIMEOUT=30000

# Health check configuration
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_INTERVAL=30000

#=============================================================================
# DEVELOPMENT CONFIGURATION
#=============================================================================

# Swagger API documentation (disable in production)
ENABLE_SWAGGER=false
SWAGGER_PATH=/api/docs

# Debug mode (disable in production)
DEBUG_MODE=false

#=============================================================================
# DOCKER COMPOSE SPECIFIC (when LOCAL_DEPLOYMENT_TYPE=docker-compose)
#=============================================================================

# Docker-specific environment variables (prefixed with DOCKER_)
# These are used when secrets are passed via Docker Compose environment
# DOCKER_ANTHROPIC_API_KEY=sk-ant-your-key-here
# DOCKER_OPENAI_API_KEY=sk-your-key-here
# DOCKER_JWT_SECRET=your-jwt-secret-here